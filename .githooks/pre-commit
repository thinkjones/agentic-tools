#!/usr/bin/env bash
#
# Pre-commit gate for agentic-tools.
#
# The gate itself lives in .githooks/gate.sh, which .githooks/pre-push also
# uses. This hook only decides whether the gate fires: a commit that stages
# none of the gated paths is not intercepted, a commit that stages one of
# them is refused when the gate fails.
#
# The gate runs against a scratch copy of the index, so a refused commit
# leaves your working tree exactly as you left it.
#
# Enable it per clone with either of:
#
#   git clone --config core.hooksPath=.githooks <url>   # at clone time
#   python3 scripts/setup_hooks.py                       # for an existing clone

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$ROOT" ] || [ ! -d "$ROOT" ]; then
  printf '\npre-commit: not inside a git working tree.\n' >&2
  exit 1
fi

GATE_LABEL="pre-commit" "$ROOT/.githooks/gate.sh" --staged
exit $?
